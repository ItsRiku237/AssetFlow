generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id                     String          @id @default(cuid())
  name                   String
  email                  String          @unique
  emailVerified          DateTime?
  image                  String?
  role                   Role            @default(EMPLOYEE)
  passwordHash           String?
  /// True for newly-created accounts that have not yet linked to an
  /// Employee directory record. Dashboard access is blocked until false.
  onboardingRequired     Boolean         @default(false)
  /// Explicit account status for admin accounts. DEACTIVATED blocks
  /// dashboard access without touching the onboarding flow.
  status                 UserStatus      @default(ACTIVE)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  accounts               Account[]
  auditLogs              AuditLog[]
  employee               Employee?
  notifications          Notification[]
  reviewedReturnRequests ReturnRequest[] @relation("ReturnRequestReviewer")
  sessions               Session[]

  @@map("users")
}

/// OAuth provider link (Google, etc.) — required by the Auth.js Prisma adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Present for Auth.js adapter compatibility. Sessions themselves are
/// issued as JWTs (required for the Credentials provider), so this
/// table is not written to at runtime.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Company-wide employee directory record. Independent of User: an
/// admin can provision an Employee (directory entry) before that
/// person has ever signed in. `userId` is set once/if the employee
/// links or signs up for a login account (a later task). Deleting a
/// linked User does not delete the directory record or its history
/// (onDelete: SetNull) — it just unlinks the account.
model Employee {
  id             String            @id @default(cuid())
  userId         String?           @unique
  employeeCode   String            @unique
  name           String
  email          String?
  department     String?
  designation    String?
  phone          String?
  status         EmployeeStatus    @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignments    AssetAssignment[]
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  returnRequests ReturnRequest[]

  @@index([status])
  @@index([department])
  @@map("employees")
}

/// A trackable company asset. `status` drives the lifecycle state
/// machine enforced in the application layer.
model Asset {
  id                 String              @id @default(cuid())
  assetTag           String              @unique
  name               String
  type               String
  brand              String?
  model              String?
  serialNumber       String?             @unique
  processor          String?
  ram                String?
  storage            String?
  storageType        String?
  purchaseDate       DateTime?
  purchasePrice      Decimal?            @db.Decimal(10, 2)
  warrantyExpiry     DateTime?
  imageUrl           String?
  status             AssetStatus         @default(AVAILABLE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        AssetAssignment[]
  maintenanceRecords MaintenanceRecord[]
  returnRequests     ReturnRequest[]
  location           AssetLocation?

  @@index([status])
  @@map("assets")
}

/// Full custody history for an asset. A new row is created on every
/// assignment; it is never overwritten, only closed out via
/// `status`/`returnedAt` so history is preserved.
model AssetAssignment {
  id         String           @id @default(cuid())
  assetId    String
  employeeId String
  status     AssignmentStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())
  returnedAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@map("asset_assignments")
}

/// Employee-initiated request to return an assigned asset. Admin
/// review moves this to APPROVED/REJECTED.
model ReturnRequest {
  id           String              @id @default(cuid())
  assetId      String
  employeeId   String
  reason       String
  status       ReturnRequestStatus @default(PENDING)
  requestedAt  DateTime            @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("ReturnRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@map("return_requests")
}

/// Servicing/repair history. An asset can have many records over its
/// lifetime.
model MaintenanceRecord {
  id          String    @id @default(cuid())
  assetId     String
  issue       String
  description String?
  vendor      String?
  cost        Decimal?  @db.Decimal(10, 2)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("maintenance_records")
}

/// Append-only audit trail for significant system actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Hashed OTP for employee account activation. One active record per
/// employeeCode at a time — a new send invalidates the previous one
/// via usedAt. Never store the raw code, only its SHA-256 hash.
model EmployeeOtp {
  id           String    @id @default(cuid())
  employeeCode String
  codeHash     String
  expiresAt    DateTime
  attempts     Int       @default(0)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([employeeCode, createdAt])
  @@map("employee_otps")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETURN_REQUESTED
  IN_REPAIR
  RETIRED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  OFFICE
  REMOTE
  OTHER
}

/// Physical location of an asset, independent of assignment/custody.
/// One record per asset at most (one-to-one via @unique on assetId).
/// Cleared by the admin when location is removed.
model AssetLocation {
  id           String       @id @default(cuid())
  assetId      String       @unique
  locationType LocationType
  /// Building / office name — OFFICE only
  building     String?
  /// Floor — OFFICE only
  floor        String?
  /// Room — OFFICE only
  room         String?
  /// Desk/seat — OFFICE only
  desk         String?
  /// Free-text description — REMOTE and OTHER
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_locations")
}
