# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assetflow?schema=public"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of the deployed app (used by Auth.js for callbacks).
AUTH_URL="http://localhost:3000"

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Resend — transactional email for OTP delivery during employee activation.
# Get a free API key at https://resend.com
RESEND_API_KEY="re_your_resend_api_key"

# Sender address shown on OTP emails.
#
# LOCAL DEV (Resend free plan, no verified domain):
#   Set RESEND_FROM to "onboarding@resend.dev"
#   IMPORTANT: Resend will only deliver to the email address that owns the
#   Resend account. The employee directory email must be that same address.
#   RESEND_FROM="onboarding@resend.dev"
#
# PRODUCTION (after verifying a domain at resend.com/domains):
#   RESEND_FROM="AssetFlow <no-reply@yourdomain.com>"
#   Emails will deliver to any recipient.
RESEND_FROM="onboarding@resend.dev"