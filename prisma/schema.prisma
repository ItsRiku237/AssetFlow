// AssetFlow database schema
// Connection URL and migration settings live in prisma.config.ts
// (Prisma 7 no longer allows `url` in the datasource block here).
// Run `npx prisma generate` after any change, and
// `npx prisma migrate dev` to create/apply a migration.

generator client {
  provider   = "prisma-client-js"
  // Adapter-based engine: no Rust query-engine binary is downloaded
  // or shipped. Requires passing a driver adapter to `new PrismaClient()`
  // (see src/lib/prisma.ts and prisma/seed.ts).
  engineType = "client"
  // Keeps the classic `@prisma/client` import path working everywhere
  // in the app unchanged, instead of Prisma 7's new default of
  // requiring a custom output path.
  output     = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EMPLOYEE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETURN_REQUESTED
  IN_REPAIR
  RETIRED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)
  /// Bcrypt hash. Null for users who only ever sign in via Google OAuth.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  employee              Employee?
  reviewedReturnRequests ReturnRequest[] @relation("ReturnRequestReviewer")
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@map("users")
}

/// OAuth provider link (Google, etc.) — required by the Auth.js Prisma adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Present for Auth.js adapter compatibility. Sessions themselves are
/// issued as JWTs (required for the Credentials provider), so this
/// table is not written to at runtime.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Employee-specific profile for a User. Kept separate from User so
/// User can stay a lean identity/auth record.
model Employee {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String   @unique
  department   String
  designation  String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments    AssetAssignment[]
  returnRequests ReturnRequest[]

  @@map("employees")
}

/// A trackable company asset. `status` drives the lifecycle state
/// machine enforced in the application layer.
model Asset {
  id             String      @id @default(cuid())
  assetTag       String      @unique
  name           String
  type           String
  brand          String?
  model          String?
  serialNumber   String?     @unique
  processor      String?
  ram            String?
  storage        String?
  purchaseDate   DateTime?
  purchasePrice  Decimal?    @db.Decimal(10, 2)
  warrantyExpiry DateTime?
  imageUrl       String?
  status         AssetStatus @default(AVAILABLE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  assignments        AssetAssignment[]
  returnRequests      ReturnRequest[]
  maintenanceRecords  MaintenanceRecord[]

  @@index([status])
  @@map("assets")
}

/// Full custody history for an asset. A new row is created on every
/// assignment; it is never overwritten, only closed out via
/// `status`/`returnedAt` so history is preserved.
model AssetAssignment {
  id         String           @id @default(cuid())
  assetId    String
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status     AssignmentStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())
  returnedAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@map("asset_assignments")
}

/// Employee-initiated request to return an assigned asset. Admin
/// review moves this to APPROVED/REJECTED.
model ReturnRequest {
  id           String              @id @default(cuid())
  assetId      String
  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason       String
  status       ReturnRequestStatus @default(PENDING)
  requestedAt  DateTime            @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?               @relation("ReturnRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@map("return_requests")
}

/// Servicing/repair history. An asset can have many records over its
/// lifetime.
model MaintenanceRecord {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue       String
  description String?
  vendor      String?
  cost        Decimal?  @db.Decimal(10, 2)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())

  @@index([assetId])
  @@map("maintenance_records")
}

/// Append-only audit trail for significant system actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}
